<?xml version="1.0" encoding="utf-8"?>
<!-- Them thu muc Lib/ vao duong tim thu vien cua trinh lien ket.

     Vi sao can: Engine/Src/KWin32.h:145 co #pragma comment(lib,"common.lib"), nen
     moi project include header do deu doi common.lib luc lien ket. Cac project
     Engine/Core/S3Client tim thay qua bien moi truong LIB, nhung Represent2 thi
     khong — da do: LIB dat dung tuyet doi, file co that 4.953.460 byte, van
     "LNK1104: cannot open file 'common.lib'". Thay vi doan tiep, khai thang duong
     tim vao AdditionalLibraryDirectories — cach nay khong phu thuoc bien moi truong.

     Thu muc MultiServer\Common\Release dat TRUOC Lib/: Lib/common.lib san co la ban
     dung o che do GO LOI (cac .obj cua no tham chieu operator new[] cua debug heap,
     std::_DebugHeapTag_t) nen keo theo libcpmtd.lib/atlsd.lib va gay LNK2038. Ban tu
     dung tu MultiServer/Common cung mot cau hinh Release thi khong.

     Nap bang /p:ForceImportBeforeCppTargets tren dong lenh msbuild.
     $(MSBuildThisFileDirectory) tro toi .github/msbuild/ nen di len 2 muc la goc repo. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- /Zc:sizedDealloc- : tra lai hanh vi truoc C++14. Nguon nay dung placement new
           kieu `new(kich_thuoc) CBuffer(...)` (MultiServer/Common/Buffer.cpp:182,
           IOBuffer.cpp:170) trong khi lop co san operator delete(void*, size_t).
           Tu C++14, ham do tro thanh "usual deallocation function" nen trinh dich chon
           no lam placement delete va bao error C2956. Tat sized dealloc la het,
           khong phai sua nguon. Cung ho voi /Zc:forScope- da dung o buoc chung. -->
      <AdditionalOptions>/Zc:sizedDealloc- %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(MSBuildThisFileDirectory)..\..\ClientAnti_JX1\SwordOnline\Sources\MultiServer\Common\Release;$(MSBuildThisFileDirectory)..\..\ClientAnti_JX1\SwordOnline\Lib;$(MSBuildThisFileDirectory)..\..\ClientAnti_JX1\SwordOnline\Lib\Release;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
</Project>
